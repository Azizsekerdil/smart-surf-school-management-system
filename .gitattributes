# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.mo binary
*.ps1 text eol=crlf
# Kabuk betikleri CI runner'ında LF ile çalışmalıdır (CRLF "bad interpreter ^M" verir).
*.sh text eol=lf
*.bat text eol=crlf
