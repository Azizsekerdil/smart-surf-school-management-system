{
  "name": "smart-surf-school-management-system",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Front-end asset pipeline for the Smart Surf School Management System",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --watch",
    "vendor": "node scripts/vendor_assets.js",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15"
  },
  "dependencies": {
    "htmx.org": "^1.9.12",
    "alpinejs": "^3.14.9",
    "chart.js": "^4.4.7",
    "lucide-static": "^0.468.0"
  }
}
