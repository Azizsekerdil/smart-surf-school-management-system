# =============================================================================
# Smart Surf School Management System — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#
#     Copy-Item .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed.
#
# EVERY CREDENTIAL BELOW IS DELIBERATELY EMPTY OR A LITERAL PLACEHOLDER.
# There is no real key, token, password or connection string anywhere in this
# repository, its history, its fixtures, its screenshots or its documentation.
# You supply your own after installation.
#
# A provider with no key reports NOT_CONFIGURED and makes no network call.
# Local AI and every non-AI feature keep working. The UI shows only the
# provider name, its status and the last 4 characters of the key -- never the
# key itself -- and "Test connection" runs only when you press it.
# =============================================================================

# -----------------------------------------------------------------------------
# WHERE THE SETTINGS MODULE COMES FROM  (read this first)
# -----------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE CANNOT be set in this file for a WSGI/ASGI server.
# .env is read from inside config/settings/base.py, which only runs after
# Django has already chosen a settings module. Set it in the real process
# environment instead:
#
#     setx DJANGO_SETTINGS_MODULE config.settings.prod        (Windows)
#     export DJANGO_SETTINGS_MODULE=config.settings.prod      (POSIX)
#
# config/wsgi.py and config/asgi.py now refuse to start without it rather than
# silently falling back to the development profile.

# -----------------------------------------------------------------------------
# CORE DJANGO
# -----------------------------------------------------------------------------
# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Europe/Istanbul
DJANGO_LANGUAGE_CODE=tr

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Development default (no server required):
DATABASE_URL=sqlite:///db.sqlite3
# Production target — PostgreSQL. Fill in your own user and password; the
# placeholder below is not a credential.
# DATABASE_URL=postgres://YOUR_DB_USER_HERE:YOUR_DB_PASSWORD_HERE@localhost:5432/surf_school
DATABASE_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# CACHE / BROKER  (optional — the app degrades gracefully when absent)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# When True, Celery tasks run synchronously in-process (no worker/Redis needed).
CELERY_TASK_ALWAYS_EAGER=True

# -----------------------------------------------------------------------------
# BUSINESS DEFAULTS
# -----------------------------------------------------------------------------
SCHOOL_NAME=Smart Surf School
SCHOOL_CURRENCY=TRY
SCHOOL_DEFAULT_LATITUDE=38.2800
SCHOOL_DEFAULT_LONGITUDE=26.3700
SCHOOL_DEFAULT_SPOT_NAME=Alacati

# -----------------------------------------------------------------------------
# SURF / WEATHER DATA PROVIDER
# -----------------------------------------------------------------------------
# open-meteo (free, no key, default) | stormglass | manual
SURF_PROVIDER=open-meteo
SURF_PROVIDER_CACHE_SECONDS=1800
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# Only needed if SURF_PROVIDER=stormglass
STORMGLASS_API_KEY=

# -----------------------------------------------------------------------------
# AI — GLOBAL
# -----------------------------------------------------------------------------
# auto | local_only | cloud_only
AI_ROUTING_MODE=local_only
AI_DEFAULT_PROVIDER=lmstudio
AI_REQUEST_TIMEOUT=120
AI_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# AI — LOCAL (LM Studio, OpenAI-compatible server)
# -----------------------------------------------------------------------------
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM Studio requires the OpenAI-compatible header to be present but ignores
# its value; "lm-studio" is the literal string its own documentation uses.
# It is not a credential and grants nothing.
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL_GENERAL=google/gemma-4-12b-qat
LM_STUDIO_MODEL_VISION=qwen/qwen3-vl-8b
LM_STUDIO_MODEL_MATH=qwen2.5-math-7b-instruct
LM_STUDIO_MODEL_LIGHT_VISION=moondream-2b-2025-04-14
LM_STUDIO_MODEL_EMBEDDING=text-embedding-nomic-embed-text-v1.5

# -----------------------------------------------------------------------------
# AI — NVIDIA NIM  (https://build.nvidia.com)
# -----------------------------------------------------------------------------
# Get a key at https://build.nvidia.com -> your profile -> API Keys.
# Leave empty to keep the provider disabled. Set it to your own key, or to the
# literal YOUR_PROVIDER_API_KEY_HERE while you are wiring things up.
# NEVER commit the real value.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# -----------------------------------------------------------------------------
# AI — ANTHROPIC CLAUDE
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# AI — GENERIC OPENAI-COMPATIBLE PROVIDER (optional)
# -----------------------------------------------------------------------------
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# -----------------------------------------------------------------------------
# AI DEVELOPMENT TERMINAL — SECURITY
# -----------------------------------------------------------------------------
# Absolute path the terminal may never escape. Leave blank to use BASE_DIR.
AI_TERMINAL_WORKSPACE=
AI_TERMINAL_ENABLED=True
AI_TERMINAL_TIMEOUT_SECONDS=120
AI_TERMINAL_MAX_OUTPUT_BYTES=200000
# Never set to True on a shared or production machine.
AI_TERMINAL_ALLOW_UNSAFE=False

# -----------------------------------------------------------------------------
# BACKUP
# -----------------------------------------------------------------------------
BACKUP_ROOT=backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# Optional: pg_dump / pg_restore location if not on PATH
PG_DUMP_PATH=
PG_RESTORE_PATH=

# -----------------------------------------------------------------------------
# EMAIL / NOTIFICATIONS
# -----------------------------------------------------------------------------
# console (dev) | smtp
EMAIL_BACKEND_MODE=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@surfschool.local

# -----------------------------------------------------------------------------
# SECURITY (production hardening — ignored when DJANGO_DEBUG=True)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
# NOTE: a FIELD_ENCRYPTION_KEY variable used to be documented here as "the
# Fernet key used to encrypt provider API keys stored in the database". No
# such encryption code ever existed, and the design is the opposite: provider
# keys are read from the environment and are never written to the database at
# all. The variable has been removed rather than left advertising a control
# the product does not implement.
